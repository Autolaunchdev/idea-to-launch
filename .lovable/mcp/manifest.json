              "type": "number",
              "minimum": 0,
              "description": "Horas invertidas."
            },
            "rate": {
              "type": "number",
              "minimum": 0,
              "description": "Tarifa interna por hora en euros."
            },
            "cash": {
              "type": "number",
              "minimum": 0,
              "description": "Pagos directos atribuibles en euros."
            },
            "income": {
              "type": "number",
              "minimum": 0,
              "description": "Ingresos cobrados en euros."
            }
          },
          "required": [
            "hours",
            "rate",
            "cash",
            "income"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
